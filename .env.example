PORT=3000
# Required in production: a long random string used to sign session cookies
SESSION_SECRET=change-me

# Production database (Turso, free): libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local development fallback (used when TURSO_DATABASE_URL is empty)
DB_PATH=./data/speedpulse.db
